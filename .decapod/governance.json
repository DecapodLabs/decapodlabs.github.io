        "tests/pricing_signup_test.ts"
      ]
    },
    "claim-public-confidentiality": {
      "statement": "All public website changes and living specs omit private backend filenames, migration numbers, internal database symbols, and Stripe price/product/account IDs.",
      "falsifier": "Any match against private backend symbols or Stripe object/secret patterns in authored files or specs.",
      "status": "supported",
      "proof_refs": [
        "scripts/check-site.ts"
      ]
    },
    "claim-signup-auth-and-states": {
      "statement": "Authenticated /signup enforces PKCE auth before showing org/repo/billing data, rejects hostile return URLs and URL tokens, supports Google->GitHub step-up and repo selection, and surfaces fail-closed states plus server-quoted Checkout and ready CLI guidance.",
